{
  "name": "mysql-to-zod",
  "version": "2.3.2",
  "description": "Convert MySQL schemas into Zod schemas",
  "source": "src/main.ts",
  "main": "dist/main.js",
  "module": "dist/module.js",
  "bin": {
    "mysql-to-zod": "dist/main.js"
  },
  "scripts": {
    "mysql-to-zod": "tsx ./src/main.ts",
    "dev": "tsx ./src/main.ts",
    "build": "zx ./build.mjs && zx ./addShebang.mjs",
    "debugBuild": "esbuild ./src/main.ts --bundle --sourcemap --platform=node --outfile=./dist/main.js --external:prettier",
    "test": "vitest",
    "type": "tsc --noEmit",
    "fmt": "pnpm biome format --write ./src",
    "check": "pnpm biome check --write ./src",
    "pub": "zx ./build.mjs && zx ./addShebang.mjs && npm publish",
    "knip": "knip"
  },
  "keywords": [
    "typescript",
    "zod",
    "mysql",
    "schema",
    "sql"
  ],
  "author": "yuumillar",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testcontainers/mysql": "^12.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@vitest/ui": "^4.1.11",
    "esbuild": "^0.28.2",
    "knip": "^6.42.1",
    "peggy": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "cosmiconfig-typescript-loader": "^6.3.0",
    "effect": "^3.22.2",
    "fs-extra": "^11.4.0",
    "immer": "^11.1.18",
    "mysql2": "^3.24.4",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-sql": "^0.20.0",
    "ts-case-convert": "^2.3.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.2"
  },
  "volta": {
    "node": "18.17.0",
    "npm": "9.8.1"
  }
}
